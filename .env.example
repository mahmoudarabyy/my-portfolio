# Leave both values empty to use the existing local projects.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Full production URL; used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Import script only. Never prefix this token with NEXT_PUBLIC_.
# Remove it after the one-time import. Studio uses your Sanity login.
SANITY_API_WRITE_TOKEN=
